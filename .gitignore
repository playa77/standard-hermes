# Credentials and secrets — never commit
.env
.env.*
.env.template
auth.json
auth.lock
credentials*.json
secrets.*
*.pem
*.key
**/.env
**/.env.*
**/auth.json
**/credentials*.json
**/*.pem
**/*.key

# Root-level runtime databases and process state
/state.db
/state.db-*
/hermes_state.db*
/response_store.db*
/kanban.db*
/projects.db
/gateway.pid
/gateway_state.json
/processes.json
/active_profile
/.update_check

# Root-level user data — never distribute
/memories/
/sessions/
/logs/
/plans/
/workspace/
/home/

# Root-level caches and generated artifacts
/image_cache/
/audio_cache/
/document_cache/
/browser_screenshots/
/cache/

# Hermes host/runtime artifacts (root only; don't hide same-named skills)
/hermes-agent/
/.worktrees/
/profiles/
/bin/
/node_modules/
**/node_modules/
/local/

# Root-level checkpoints and backups
/checkpoints/
/sandboxes/
/backups/

# Hermes/plugin bookkeeping and generated bytecode
plugins/.install-metadata.json*
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.DS_Store
skills/.*
cron/*
!cron/jobs.json
/errors.log
/.hermes_history
